{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    // `strict` does NOT include these. Without noImplicitReturns a function
    // whose switch/if-chain misses a union variant silently returns `undefined`
    // instead of failing to compile — the exact gap the `never` binding in
    // core/orchestration-contract/effects.ts was hand-written to cover.
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    // ../calibration and ../probes have no node_modules of their own: their tests run on the
    // engine's pinned Vitest and fast-check, so they typecheck against them.
    "paths": {
      "vitest": ["./node_modules/vitest"],
      "fast-check": ["./node_modules/fast-check"]
    }
  },
  // Everything TypeScript in the repository typechecks, by glob — a new
  // script, probe or Pi module is a compiler root the moment it exists, with
  // no per-file entry to forget. The probes' .mjs drivers are JavaScript:
  // linted (scripts/lint-project.ts), typed at their seam by
  // probes/emission-qualification/probe-analysis.d.mts, not compiled here.
  "include": [
    "src",
    "tests",
    "scripts/**/*.ts",
    "*.ts",
    "../pi",
    "../calibration",
    "../scripts/**/*.ts",
    "../probes/**/*.ts",
    "../probes/**/*.mts"
  ]
}
