{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    // `strict` does NOT include these. Without noImplicitReturns a function
    // whose switch/if-chain misses a union variant silently returns `undefined`
    // instead of failing to compile — the exact gap the `never` binding in
    // core/orchestration-contract/effects.ts was hand-written to cover.
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    // ../calibration has no node_modules of its own: its tests run on the
    // engine's pinned Vitest and fast-check, so they typecheck against them.
    "paths": {
      "vitest": ["./node_modules/vitest"],
      "fast-check": ["./node_modules/fast-check"]
    }
  },
  "include": ["src", "tests", "../pi", "../calibration", "scripts/typecheck.ts", "vitest.config.ts"]
}
