{
  "name": "loom-hooks",
  "version": "1.0.0",
  "description": "Loom orchestration hooks for Claude Code",
  "type": "module",
  "scripts": {
    "test": "vitest run && npm run test:smoke",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "bash ../scripts/smoke-panel-mode.sh && bash ../scripts/smoke-review-panel.sh && bash ../scripts/smoke-standalone-review.sh && bash ../scripts/smoke-pi-resources.sh",
    "calibrate:models": "LOOM_RUN_MODEL_CALIBRATION=1 bun ../scripts/run-model-calibration.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "fast-check": "^4.5.3",
    "ts-pattern": "^5.9.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
